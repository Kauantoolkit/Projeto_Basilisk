# ── Stage 1: Build basilisk-libs packages ──────────────────────────────────
FROM node:20 AS libs

RUN corepack enable && corepack prepare pnpm@9.1.0 --activate

WORKDIR /workspace/basilisk-libs

COPY basilisk-libs/package.json basilisk-libs/pnpm-workspace.yaml basilisk-libs/pnpm-lock.yaml* basilisk-libs/turbo.json basilisk-libs/tsconfig.base.json ./
COPY basilisk-libs/packages ./packages

RUN pnpm install --no-frozen-lockfile

# Build all packages (CJS + ESM + DTS) via turbo
RUN pnpm run build

# ── Stage 2: Build frontend ────────────────────────────────────────────────
FROM node:20-alpine AS build

WORKDIR /workspace

# Copy pre-built basilisk-libs
COPY --from=libs /workspace/basilisk-libs /workspace/basilisk-libs

# Copy frontend
COPY gym-manager/web /workspace/gym-manager/web

WORKDIR /workspace/gym-manager/web
RUN npm install --legacy-peer-deps
RUN npm run build

# ── Stage 3: Serve with nginx ─────────────────────────────────────────────
FROM nginx:alpine

COPY --from=build /workspace/gym-manager/web/dist /usr/share/nginx/html

RUN printf 'server {\n\
    listen 80;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
\n\
    location /api {\n\
        proxy_pass http://backend:8081;\n\
        proxy_set_header Host $host;\n\
        proxy_set_header X-Real-IP $remote_addr;\n\
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
    }\n\
\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80
