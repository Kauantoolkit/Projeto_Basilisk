# ── Stage 1: Build basilisk-libs-java + gym-manager ────────────────────────
FROM maven:3.9-eclipse-temurin-21 AS build

# Copy and install basilisk-libs-java first (cached layer)
COPY basilisk-libs-java /workspace/basilisk-libs-java
WORKDIR /workspace/basilisk-libs-java
RUN mvn clean install -DskipTests -q

# Copy and build gym-manager
COPY gym-manager /workspace/gym-manager
WORKDIR /workspace/gym-manager
RUN mvn clean package -DskipTests -q

# ── Stage 2: Run ───────────────────────────────────────────────────────────
FROM eclipse-temurin:21-jre

WORKDIR /app
COPY --from=build /workspace/gym-manager/target/*.jar app.jar

EXPOSE 8081
ENTRYPOINT ["java", "-jar", "app.jar"]
