<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.basilisk.gym</groupId>
    <artifactId>gym-manager</artifactId>
    <version>1.0.0</version>
    <name>gym-manager</name>
    <description>Gym Manager — controle financeiro e assinaturas de academia, built with Basilisk libs</description>

    <properties>
        <java.version>21</java.version>
        <basilisk.version>0.1.0</basilisk.version>
    </properties>

    <dependencies>
        <!-- Basilisk modules -->
        <dependency>
            <groupId>com.basilisk</groupId>
            <artifactId>basilisk-core</artifactId>
            <version>${basilisk.version}</version>
        </dependency>
        <dependency>
            <groupId>com.basilisk</groupId>
            <artifactId>basilisk-security</artifactId>
            <version>${basilisk.version}</version>
        </dependency>
        <dependency>
            <groupId>com.basilisk</groupId>
            <artifactId>basilisk-finance</artifactId>
            <version>${basilisk.version}</version>
        </dependency>
        <dependency>
            <groupId>com.basilisk</groupId>
            <artifactId>basilisk-audit</artifactId>
            <version>${basilisk.version}</version>
        </dependency>
        <dependency>
            <groupId>com.basilisk</groupId>
            <artifactId>basilisk-web</artifactId>
            <version>${basilisk.version}</version>
        </dependency>
        <dependency>
            <groupId>com.basilisk</groupId>
            <artifactId>basilisk-email</artifactId>
            <version>${basilisk.version}</version>
        </dependency>

        <!-- Spring -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Database -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Testes -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>