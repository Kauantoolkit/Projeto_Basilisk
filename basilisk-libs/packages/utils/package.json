{
  "name": "@basilisk/utils",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kauantoolkit/Projeto_Basilisk.git",
    "directory": "basilisk-libs/packages/utils"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "description": "Funções utilitárias puras — sem dependências de framework",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@basilisk/config": "workspace:*",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^1.5.3"
  },
  "sideEffects": false,
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.3.0"
  }
}
